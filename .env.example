# ─── Supabase Database & Auth (Required) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Site URL (Required for Vercel / Production) ───
# e.g. https://your-shirt-store.vercel.app or https://shirtbazaar.pk
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ─── Admin Access (Required) ───
# Comma-separated list of emails allowed to log into /admin
ADMIN_EMAILS=admin@example.com,your-email@gmail.com

# ─── JazzCash Merchant / Manual Transfer (Required for JazzCash checkout) ───
NEXT_PUBLIC_JAZZCASH_TILL_ID=984456353
NEXT_PUBLIC_JAZZCASH_MERCHANT_NAME=FAHAD Shop
NEXT_PUBLIC_JAZZCASH_ACCOUNT_NUMBER=984456353
NEXT_PUBLIC_JAZZCASH_ACCOUNT_TITLE=FAHAD Shop

# ─── Easypaisa Manual Transfer (Required for Easypaisa checkout) ───
NEXT_PUBLIC_EASYPAISA_ACCOUNT_NUMBER=0345-1234567
NEXT_PUBLIC_EASYPAISA_ACCOUNT_TITLE=Your Store Name

# ─── Google Gemini AI (Required for AI Semantic Search & Size Advisor) ───
GEMINI_API_KEY=AIzaSy...

# ─── Store Transactional Emails (100% Free via Gmail SMTP / Nodemailer) ───
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate a 16-character App Password (e.g. "abcd efgh ijkl mnop")
GMAIL_USER=yourstore@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
EMAIL_FROM_NAME=FHD Store
EMAIL_FROM=yourstore@gmail.com

# ─── Resend Transactional Emails (Optional Fallback / If you have custom domain) ───
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=FHD Store <orders@yourdomain.com>

# ─── Stripe Card Payments (Optional / Disabled if not using Stripe) ───
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Upstash Redis (Optional - for API rate limiting) ───
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...