# Supabase — shirt-store project (ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
 SUPABASE_SERVICE_ROLE_KEY=e


# Stripe — fill in from your Stripe dashboard
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET= 


# Upstash Redis (for API rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel access — comma-separated emails allowed into /admin
ADMIN_EMAILS=

# JazzCash Manual Payment — your JazzCash wallet number & account title
NEXT_PUBLIC_JAZZCASH_ACCOUNT_NUMBER=03XX-XXXXXXX
NEXT_PUBLIC_JAZZCASH_ACCOUNT_TITLE=Your Store Name

# Easypaisa Manual Payment — your Easypaisa wallet number & account title
NEXT_PUBLIC_EASYPAISA_ACCOUNT_NUMBER=03XX-XXXXXXX
NEXT_PUBLIC_EASYPAISA_ACCOUNT_TITLE=Your Store Name