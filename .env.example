# ─── Supabase Database & Auth (Required) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Site URL (Required for Vercel / Production) ───
# e.g. https://your-shirt-store.vercel.app or https://shirtbazaar.pk
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ─── Admin Access (Required) ───
# Comma-separated list of emails allowed to log into /admin
ADMIN_EMAILS=admin@example.com,your-email@gmail.com

# ─── JazzCash Manual Transfer (Required for JazzCash checkout) ───
NEXT_PUBLIC_JAZZCASH_ACCOUNT_NUMBER=0300-1234567
NEXT_PUBLIC_JAZZCASH_ACCOUNT_TITLE=Your Store Name

# ─── Easypaisa Manual Transfer (Required for Easypaisa checkout) ───
NEXT_PUBLIC_EASYPAISA_ACCOUNT_NUMBER=0345-1234567
NEXT_PUBLIC_EASYPAISA_ACCOUNT_TITLE=Your Store Name

# ─── Google Gemini AI (Required for AI Semantic Search & Size Advisor) ───
GEMINI_API_KEY=AIzaSy...

# ─── Resend Transactional Emails (Optional / Recommended) ───
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Shirt Bazaar <orders@yourdomain.com>

# ─── Stripe Card Payments (Optional / Disabled if not using Stripe) ───
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Upstash Redis (Optional - for API rate limiting) ───
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...